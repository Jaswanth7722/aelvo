# Prevent .gitignore and .npmignore from being included in the package
# Use the "files" array in package.json to control what's published

# Always include bin/ and cli/ directories
include bin/
include cli/

# Exclude test and dev files
exclude tests/
exclude *_test.py
exclude test_*.py
exclude pytest.ini
exclude ruff.toml
exclude .gitignore
exclude .gitattributes
exclude validate.py

# Exclude CI/CD and docs
exclude .github/
exclude docs/
exclude *.md

# Exclude node_modules and Python artifacts
exclude node_modules/
exclude __pycache__/
exclude *.pyc
exclude *.pyo
exclude .venv/
exclude dist/
exclude build/
exclude *.egg-info/
