# -----------------------------------------------------------
# .env.example  --  AELVO Environment Variables Reference
# -----------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is excluded from git via the existing *.env rule
# in .gitignore.  Never commit real credentials.
# -----------------------------------------------------------

# -- LLM Provider --------------------------------------------

# Provider name: openai, anthropic, google, nvidia, groq, etc.
LLM_PROVIDER=openai

# API key for your chosen provider
API_KEY=sk-...

# Model override (optional, uses provider default if not set)
# MODEL=gpt-4

# Bounded per-request LLM HTTP timeout in seconds (default 120). Prevents a
# slow/queued upstream (e.g. OpenRouter :free models) from blocking silently
# for the SDK default 600s.
# AELVO_LLM_TIMEOUT=120

# Automatic retries on transient LLM API failures (default 0). The SDKs honor
# the server's retry-after header (up to 60s) per retry, so on rate-limited
# free tiers retries look like a hang. Failing fast is better; raise this to
# re-enable retries for transient 5xx errors.
# AELVO_LLM_MAX_RETRIES=0

# Per-call max output tokens (default 4096). Aggregator providers default to
# the model's full budget (often 65536) which wastes credits and latency.
# AELVO_MAX_TOKENS=4096
